{
  "hooks": {
    "before:init": ["npm run format:check", "npm run lint:check", "npm test"]
  },
  "git": {
    "commitMessage": "Release ${version}",
    "commitArgs": ["-S"],
    "tagAnnotation": "Release ${version}",
    "tagArgs": ["-s"],
    "changelog": false
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  }
}
